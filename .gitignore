# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-bridge
dist-probe
dist-brand
dist-storage-probe
dist-workspace-probe
dist-ssr
*.local

# Env files — never commit real values. .env.example is the tracked template.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.claude/worktrees/

# Playwright output from the zero-network probe (traces, error contexts, HTML
# report). Regenerated by `npm run test:network`; never a source of truth.
/test-results/
/playwright-report/

# Release artifacts are build output, reproducible from the recorded commit.
# Anchored to the repository root: an unanchored `release/` also matches
# `tests/release/`, which silently swallowed the release suite.
/release/

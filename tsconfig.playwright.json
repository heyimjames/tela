{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.playwright.tsbuildinfo",
    "target": "ES2023",
    // DOM as well as node: the probe's instrumentation runs inside the page.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // The zero-network gate is typechecked by `npm run typecheck` like the rest of
  // the repo. A gate that only TypeScript-at-runtime (via Playwright's own
  // transpile) would let a rename break it silently until the next CI run.
  "include": ["playwright.config.ts", "tests/network"]
}

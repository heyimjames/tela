# Optional AI Assist. Leave unset to run Tela with AI disabled.
# Point these at an endpoint YOU control that proxies to your LLM provider, so
# no API key is ever exposed in the browser. See docs/ai-endpoint.md.

# Base origin of your AI proxy, e.g. https://your-api.example.com
VITE_AI_API_ORIGIN=

# Request path on that origin (default: /api/tela-ai)
# VITE_AI_API_PATH=/api/tela-ai

# Workspace mode. Leave unset for local mode, which is what the certified offline
# payload ships as: documents live in this browser and nothing talks to a network.
# Set to `true` (or `1`) only for a hosted build. See src/storage/index.ts.
# VITE_WORKSPACE_MODE=true

# Where the hosted API answers. Leave UNSET for a production build: the compiled
# default is the mount the deployment uses (/api), documented with the proxy config
# in docs/workspace-deployment.md. Set it only for a dev server proxied onto another
# port, or a harness that mounts the API elsewhere — `/` for an API at the origin
# root. Empty is read as unset, not as `/`.
# VITE_WORKSPACE_API_BASE_URL=http://127.0.0.1:3000

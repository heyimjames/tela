  "metadata": {
    "package.json": {
      "name": "tela",
      "version": "0.1.0",
      "description": "A fast, local-first design canvas for social & ad creatives — brandable, no backend required. Built with React, Zustand and Tailwind.",
      "license": "MIT",
      "type": "module",
      "keywords": [
        "design",
        "canvas",
        "editor",
        "ads",
        "social-media",
        "svg",
        "react",
        "vite",
        "zustand",
        "figma-alternative"
      ],
      "homepage": "https://github.com/heyimjames/tela",
      "repository": {
        "type": "git",
        "url": "https://github.com/heyimjames/tela.git"
      },
      "bugs": {
        "url": "https://github.com/heyimjames/tela/issues"
      },
      "scripts": {
        "dev": "vite",
        "build": "npm run build:app && npm run build:bridge && npm run build:mcp",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:network": "playwright test",
        "test:storage": "playwright test --config playwright.storage.config.ts",
        "test:brand": "playwright test --config playwright.brand.config.ts",
        "test:integration:server": "vite-node scripts/cli517-integration.mts",
        "build:app": "vite build",
        "build:bridge": "vite build --base=./ --outDir dist-bridge",
        "build:mcp": "node scripts/build-mcp.mjs",
        "release:build": "node scripts/build-release.mjs",
        "release:verify": "node scripts/verify-release.mjs",
        "release:reproduce": "node scripts/reproduce-release.mjs",
        "verify:payload": "node scripts/verify-payload-noninterference.mjs",
        "payload:launch": "node scripts/launch-installed-payload.mjs",
        "test:evals": "node evaluations/run.mjs"
      },
      "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/geist": "^5.2.9",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@modelcontextprotocol/server": "2.0.0",
        "@paper-design/shaders-react": "^0.0.76",
        "@tailwindcss/vite": "^4.3.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "culori": "^4.0.2",
        "lucide-react": "^1.22.0",
        "motion": "^12.42.1",
        "nanoid": "^5.1.16",
        "playwright": "1.61.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "shadcn": "^4.12.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.2",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "zod": "4.4.3",
        "zustand": "^5.0.14"
      },
      "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@modelcontextprotocol/client": "2.0.0",
        "@playwright/test": "1.61.1",
        "@types/culori": "^4.0.1",
        "@types/node": "^25.9.4",

              "locked": {
                "type": "boolean"
              },
              "visible": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "x",
              "y",
              "width",
              "height",
              "format",
              "backgroundColor",
              "backgroundFill",
              "layers",
              "locked",
              "visible"

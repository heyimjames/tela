        },
        "name": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "name": {
                "type": "string"
              },
              "x": {
                "$ref": "#/$defs/__schema3"
              },
              "y": {
                "$ref": "#/$defs/__schema3"
              },
              "width": {
                "exclusiveMinimum": 0,
                "$ref": "#/$defs/__schema3"
              },
              "height": {
                "exclusiveMinimum": 0,
                "$ref": "#/$defs/__schema3"
              },
              "format": {
                "$ref": "#/$defs/__schema4"
              },
              "backgroundColor": {

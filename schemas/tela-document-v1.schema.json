{
  "$id": "https://schemas.clickt.ca/tela/document/v1",
  "title": "Tela portable document, v1",
  "description": "The complete editable Tela state stored as document.json inside a .tela bundle. Every object is closed: unknown properties are invalid, so a reader can never silently discard a field it does not recognise.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "name": {
      "type": "string"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema1"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema1"
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "activePageId": {
      "$ref": "#/$defs/__schema0"
    },
    "activeFrameId": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "showFrameLabels": {
          "type": "boolean"
        },
        "snapFrames": {
          "type": "boolean"
        }
      },
      "required": [
        "showFrameLabels",
        "snapFrames"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string"
          },
          "document": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "name": {
                "type": "string"
              },
              "format": {
                "$ref": "#/$defs/__schema4"
              },
              "layers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema8"
                }
              },
              "createdAt": {
                "$ref": "#/$defs/__schema1"
              },
              "updatedAt": {
                "$ref": "#/$defs/__schema1"
              },
              "autoLayouts": {
                "$ref": "#/$defs/__schema21"
              }
            },
            "required": [
              "id",
              "name",
              "format",
              "layers",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "id",
          "name",
          "document",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "productName": {
          "type": "string"
        },
        "socialHandle": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "ai": {
          "type": "object",
          "properties": {
            "productDescription": {
              "type": "string"
            },
            "targetAudience": {
              "type": "string"
            },
            "brandVoice": {
              "type": "string"
            },
            "callToAction": {
              "type": "string"
            }
          },
          "required": [
            "productDescription",
            "targetAudience",
            "brandVoice",
            "callToAction"
          ],
          "additionalProperties": false
        },
        "palette": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "productName",
        "socialHandle",
        "displayName",
        "website",
        "ai",
        "palette"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "svg",
              "icon"
            ]
          },
          "category": {
            "type": "string"
          },
          "ref": {
            "$ref": "#/$defs/__schema7"
          },
          "width": {
            "$ref": "#/$defs/__schema3"
          },
          "height": {
            "$ref": "#/$defs/__schema3"
          },
          "createdAt": {
            "$ref": "#/$defs/__schema1"
          }

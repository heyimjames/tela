        "required": [
          "id",
          "name",
          "type",
          "category",
          "ref",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "$ref": "#/$defs/__schema12"
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string"
          },
          "createdAt": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "id",
          "family",
          "weight",
          "style",
          "license",
          "ref",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "pages",
    "activePageId",
    "activeFrameId",
    "settings",
    "versions",
    "brand",
    "assets",
    "fonts"
